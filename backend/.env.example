# ──────────────────── Backend ────────────────────
APP_ENV=development
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Firebase / Google Cloud
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_SUCCESS_URL=http://localhost:8501/Subscription?success=true
STRIPE_CANCEL_URL=http://localhost:8501/Subscription?canceled=true

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
ENCRYPTION_KEY=change-me-in-production

# Email SMTP (Brevo relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=yoann.beugre1@gmail.com
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM=InvestX <contact@investxbot.com>

# Binance
BINANCE_BASE_URL=https://api.binance.com

# App defaults
DEFAULT_TIMEZONE=Europe/Paris
ALLOWED_SYMBOLS=BTCUSDC,ETHUSDC,BNBUSDC,ADAUSDC,SOLUSDC,BTC-EUR,ETH-EUR,BNB-EUR,ADA-EUR,SOL-EUR
