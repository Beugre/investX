# ──────────────────── Backend (PRODUCTION) ────────────────────
APP_ENV=production
APP_BASE_URL=https://YOUR_DOMAIN_OR_IP
LOG_LEVEL=INFO

# Firebase / Google Cloud
FIREBASE_PROJECT_ID=investx-app
GOOGLE_APPLICATION_CREDENTIALS=/opt/investx/backend/firebase-service-account.json

# Stripe (⚠️ Remplacer par vos clés LIVE ou TEST)
STRIPE_SECRET_KEY=sk_live_XXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXX
STRIPE_PRICE_ID=price_XXXXXXXXX
STRIPE_SUCCESS_URL=https://YOUR_DOMAIN_OR_IP/Subscription?success=true
STRIPE_CANCEL_URL=https://YOUR_DOMAIN_OR_IP/Subscription?canceled=true

# Telegram
TELEGRAM_BOT_TOKEN=XXXXXXXXX

# Binance
BINANCE_BASE_URL=https://api.binance.com

# App defaults
DEFAULT_TIMEZONE=Europe/Paris
ALLOWED_SYMBOLS=BTCEUR,ETHEUR,BNBEUR,ADAEUR,SOLEUR
