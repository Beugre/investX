rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chaque utilisateur ne peut lire/écrire que ses propres données
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Toutes les sous-collections (subscription, dca_config, orders, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Collection dca_locks – accessible uniquement par le backend (Admin SDK)
    // Les clients ne doivent JAMAIS y accéder directement
    match /dca_locks/{lockId} {
      allow read, write: if false;
    }
  }
}
